# AgentForge configuration
# Copy this file to .env and fill in your API keys.

# Select provider: "openai", "anthropic", or "mock" (for offline testing)
AGENTFORGE_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Vector DB / memory
CHROMA_PERSIST_DIR=.chroma

# Pipeline configuration
AGENTFORGE_MAX_REVIEW_ROUNDS=50
AGENTFORGE_MIN_REVIEW_ROUNDS=3
AGENTFORGE_LOG_LEVEL=INFO
